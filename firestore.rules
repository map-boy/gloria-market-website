rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Accounts that always have admin access. Keep these in step with
    // src/lib/config.ts. Lowercase only.
    function adminEmails() {
      // These accounts always have access. Everyone else is added from the
      // Team screen instead, which needs no redeploy.
      return [
        'techubwenge@gmail.com',  // developer
        'dprime2002@gmail.com'    // owner
      ];
    }

    function callerEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    // Built-in admins are the only ones who can hand out access.
    function isPermanentAdmin() {
      return callerEmail() != '' && callerEmail() in adminEmails();
    }

    // Anyone built in, or anyone added from the Team screen.
    function isAdmin() {
      return isPermanentAdmin() ||
        (callerEmail() != '' &&
         exists(/databases/$(database)/documents/admins/$(callerEmail())));
    }

    // The shop itself is public to read and admin-only to change.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sections/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /highlights/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The allow list is never public. A signed-in user may read their own
    // entry so the app can tell them whether they have access; admins see the
    // whole list, and only built-in admins can change it.
    match /admins/{email} {
      allow get: if request.auth != null && (email == callerEmail() || isAdmin());
      allow list: if isAdmin();
      allow write: if isPermanentAdmin();
    }
  }
}
