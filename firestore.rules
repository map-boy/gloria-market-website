rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Set this to the Google account that owns the shop. It is the only
    // account that can grant access to anyone else, and it matches
    // VITE_OWNER_EMAIL in the site's .env file. Keep it lowercase.
    function ownerEmail() {
      return 'owner@example.com';
    }

    function callerEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isOwner() {
      return callerEmail() != '' && callerEmail() == ownerEmail();
    }

    // An admin is the owner, or anyone with a document in /admins keyed by
    // their lowercase email.
    function isAdmin() {
      return isOwner() ||
        (callerEmail() != '' &&
         exists(/databases/$(database)/documents/admins/$(callerEmail())));
    }

    // The shop itself is public to read and admin-only to change.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sections/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /highlights/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The allow list is never public. A signed-in user may read their own
    // entry so the app can tell them whether they have access; only admins
    // can see the whole list, and only the owner can change it.
    match /admins/{email} {
      allow get: if request.auth != null && (email == callerEmail() || isAdmin());
      allow list: if isAdmin();
      allow write: if isOwner();
    }
  }
}
