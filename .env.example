# Firebase web app config — Project settings → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Extra accounts that always have admin access, on top of the owner
# and developer already built into src/lib/config.ts. Comma separated,
# lowercase. Anything listed here must also go in adminEmails() in
# firestore.rules and storage.rules, then be deployed.
VITE_ADMIN_EMAILS=

# Optional. The name shown before an admin sets one under Brand.
# Defaults to "D prime Rwanda LTD".
VITE_SITE_NAME=
