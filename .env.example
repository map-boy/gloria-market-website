# Firebase web app config — Project settings → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The shop owner's Google account. Always has admin access and can give access
# to other people from the Team screen. Several addresses can be listed,
# separated by commas. Lowercase.
#
# The developer account (techubwenge@gmail.com) is built into
# src/lib/config.ts and always has access, so this can be left blank.
#
# Whatever you put here must also be added to adminEmails() in firestore.rules
# and storage.rules, then deployed.
VITE_OWNER_EMAIL=
