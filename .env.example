# Firebase web app config — Project settings → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The Google account that owns the shop. It always has admin access and is the
# only one that can add or remove other admins. Must match ownerEmail() in
# firestore.rules and storage.rules. Lowercase.
VITE_OWNER_EMAIL=
